<?xml version="1.0" encoding="utf-8"?>
<!--
  FisiTexto MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build wordcraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=... -o out.msi

  Per-machine install into Program Files with a Start Menu shortcut. The installer shows the
  standard WiX dialogs: welcome + license, progress, and a finish page.

  UpgradeCode and the component GUIDs below belong to FisiTexto alone. Never copy them from (or
  into) a sibling Craft app: Windows Installer treats every package sharing an UpgradeCode as one
  product, so a shared code makes one app's installer refuse to install ("a newer version is
  already installed") or silently uninstall the other. packaging-lint.yml checks this.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="FisiTexto"
      Manufacturer="FisiLab — LARFIC/UFRGS"
      Version="$(var.Version)"
      UpgradeCode="59FEB58B-62A5-48C2-B2AA-14A45155F952"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="FisiTexto — Processador de texto (Suíte FisiLab)" Manufacturer="FisiLab — LARFIC/UFRGS" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="Uma versão mais nova do FisiTexto já está instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="WordcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="WordcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mrcandrade/larfic/tree/main/suite-fisilab" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/mrcandrade/fisitexto/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/mrcandrade/fisitexto/issues" />

    <!-- Installer UI (#198): WixUI_Minimal is welcome + license, progress, then a finish page so
         people can see the install worked. Its dialogs and bitmaps are WiX's own
         (WixToolset.UI.wixext); package.ps1 builds the license RTF from LICENSE-MIT and
         LICENSE-APACHE. The finish page offers to launch FisiTexto (ticked by default) through
         WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Abrir o FisiTexto" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#WordcraftExe]" />
    <CustomAction Id="LaunchWordcraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchWordcraft"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="FisiTexto" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="FisiTexto" Level="1">
      <ComponentGroupRef Id="WordcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="WordcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="WordcraftApp" Guid="8B97AB21-2025-4831-A9E8-A8C346EA339C">
        <File Id="WordcraftExe" Source="$(var.BinDir)\fisitexto.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="FisiTexto"
              Description="FisiTexto — Processador de texto" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="WordcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\fisitexto.exe" Value="[#WordcraftExe]" Type="string" />
      </Component>

      <!-- File associations (#295). Each document type gets a FisiTexto ProgId (name, icon, open
           command) and is listed under the extension's OpenWithProgids, so FisiTexto shows in
           Explorer's "Open with". The Word, RTF and ODT types are also FisiTexto's Capabilities
           (RegisteredApplications), so it appears in Settings › Default apps, where the user
           makes it the default (File › Options › General opens that page). Nothing here sets an
           extension's default: the installer never takes over .docx from another app. Markdown and
           plain text are only "Open with" candidates. Removed again on uninstall. -->
      <Component Id="WordcraftFileTypes" Guid="32B954A2-FD9A-45F7-96E4-7F49BA735D03">
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="FisiTexto" Value="Software\FisiTexto\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\FisiTexto\Capabilities" Name="ApplicationName" Value="FisiTexto" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FisiTexto\Capabilities" Name="ApplicationDescription" Value="Escreva e diagrame documentos; abra e salve arquivos do Word." Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FisiTexto\Capabilities" Name="ApplicationIcon" Value="&quot;[#WordcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisitexto.exe" Name="FriendlyAppName" Value="FisiTexto" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisitexto.exe\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="FisiLab.FisiTexto.Document" Description="Documento do Word" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FisiLab.FisiTexto.Document\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docx\OpenWithProgids" Name="FisiLab.FisiTexto.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisitexto.exe\SupportedTypes" Name=".docx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FisiTexto\Capabilities\FileAssociations" Name=".docx" Value="FisiLab.FisiTexto.Document" Type="string" />

        <ProgId Id="FisiLab.FisiTexto.DocumentMacroEnabled" Description="Documento do Word habilitado para macro" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FisiLab.FisiTexto.DocumentMacroEnabled\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docm\OpenWithProgids" Name="FisiLab.FisiTexto.DocumentMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisitexto.exe\SupportedTypes" Name=".docm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FisiTexto\Capabilities\FileAssociations" Name=".docm" Value="FisiLab.FisiTexto.DocumentMacroEnabled" Type="string" />

        <ProgId Id="FisiLab.FisiTexto.Template" Description="Modelo do Word" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FisiLab.FisiTexto.Template\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotx\OpenWithProgids" Name="FisiLab.FisiTexto.Template" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisitexto.exe\SupportedTypes" Name=".dotx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FisiTexto\Capabilities\FileAssociations" Name=".dotx" Value="FisiLab.FisiTexto.Template" Type="string" />

        <ProgId Id="FisiLab.FisiTexto.TemplateMacroEnabled" Description="Modelo do Word habilitado para macro" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FisiLab.FisiTexto.TemplateMacroEnabled\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotm\OpenWithProgids" Name="FisiLab.FisiTexto.TemplateMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisitexto.exe\SupportedTypes" Name=".dotm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FisiTexto\Capabilities\FileAssociations" Name=".dotm" Value="FisiLab.FisiTexto.TemplateMacroEnabled" Type="string" />

        <ProgId Id="FisiLab.FisiTexto.LegacyDocument" Description="Documento do Word 97-2003" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FisiLab.FisiTexto.LegacyDocument\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.doc\OpenWithProgids" Name="FisiLab.FisiTexto.LegacyDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisitexto.exe\SupportedTypes" Name=".doc" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FisiTexto\Capabilities\FileAssociations" Name=".doc" Value="FisiLab.FisiTexto.LegacyDocument" Type="string" />

        <ProgId Id="FisiLab.FisiTexto.LegacyTemplate" Description="Modelo do Word 97-2003" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FisiLab.FisiTexto.LegacyTemplate\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dot\OpenWithProgids" Name="FisiLab.FisiTexto.LegacyTemplate" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisitexto.exe\SupportedTypes" Name=".dot" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FisiTexto\Capabilities\FileAssociations" Name=".dot" Value="FisiLab.FisiTexto.LegacyTemplate" Type="string" />

        <ProgId Id="FisiLab.FisiTexto.RichText" Description="Documento Rich Text" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FisiLab.FisiTexto.RichText\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.rtf\OpenWithProgids" Name="FisiLab.FisiTexto.RichText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisitexto.exe\SupportedTypes" Name=".rtf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FisiTexto\Capabilities\FileAssociations" Name=".rtf" Value="FisiLab.FisiTexto.RichText" Type="string" />

        <ProgId Id="FisiLab.FisiTexto.OpenDocumentText" Description="Texto OpenDocument" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FisiLab.FisiTexto.OpenDocumentText\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.odt\OpenWithProgids" Name="FisiLab.FisiTexto.OpenDocumentText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisitexto.exe\SupportedTypes" Name=".odt" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FisiTexto\Capabilities\FileAssociations" Name=".odt" Value="FisiLab.FisiTexto.OpenDocumentText" Type="string" />

        <ProgId Id="FisiLab.FisiTexto.Markdown" Description="Documento Markdown" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FisiLab.FisiTexto.Markdown\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.md\OpenWithProgids" Name="FisiLab.FisiTexto.Markdown" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisitexto.exe\SupportedTypes" Name=".md" Value="" Type="string" />

        <ProgId Id="FisiLab.FisiTexto.PlainText" Description="Documento de texto" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FisiLab.FisiTexto.PlainText\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.txt\OpenWithProgids" Name="FisiLab.FisiTexto.PlainText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisitexto.exe\SupportedTypes" Name=".txt" Value="" Type="string" />
      </Component>

      <Component Id="WordcraftCli">
        <File Id="WordcraftCliExe" Source="$(var.BinDir)\fisitexto-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
