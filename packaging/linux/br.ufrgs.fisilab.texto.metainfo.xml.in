<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>br.ufrgs.fisilab.texto</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Texto</name>
  <summary>Processador de texto da Suíte FisiLab (UFRGS)</summary>
  <developer id="br.ufrgs.fisilab">
    <name>FisiLab — LARFIC/UFRGS</name>
  </developer>
  <description>
    <p>
      Texto é um processador de texto livre, com faixa de opções familiar: estilos, tabelas, controle de alterações, referências, mala direta e arquivos .docx, PDF, ODT, RTF, HTML e Markdown. Faz parte da Suíte FisiLab, disponibilizada pelo FisiLab — LARFIC · UFRGS em parceria com o CTA — Centro de Tecnologia Acadêmica. Baseado no WordCraft (ArtCraft Team e contribuidores).
    </p>
  </description>
  <launchable type="desktop-id">br.ufrgs.fisilab.texto.desktop</launchable>
  <icon type="stock">br.ufrgs.fisilab.texto</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/mrcandrade/larfic/tree/main/suite-fisilab</url>
  <url type="bugtracker">https://github.com/mrcandrade/fisilab-texto/issues</url>
  <url type="help">https://github.com/mrcandrade/fisilab-texto</url>
  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>
  <keywords>
    <keyword>word processor</keyword>
    <keyword>docx</keyword>
    <keyword>document</keyword>
    <keyword>writer</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>The Open Studio Handbook sample with the Navigation pane</caption>
      <image>https://raw.githubusercontent.com/mrcandrade/fisilab-texto/main/docs/images/hero.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#f2eada</color>
    <color type="primary" scheme_preference="dark">#1a2532</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <!-- Document types WordCraft opens (#295), as in the desktop entry's MimeType=. -->
  <provides>
    <binary>fisilab-texto</binary>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.document</mediatype>
    <mediatype>application/vnd.ms-word.document.macroEnabled.12</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.template</mediatype>
    <mediatype>application/vnd.ms-word.template.macroEnabled.12</mediatype>
    <mediatype>application/msword</mediatype>
    <mediatype>application/msword-template</mediatype>
    <mediatype>application/vnd.oasis.opendocument.text</mediatype>
    <mediatype>application/rtf</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
